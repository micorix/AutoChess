<Window x:Class="AutoChess.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AutoChess.Views"
        xmlns:svc="clr-namespace:AutoChess.Services"
        Title="{x:Static svc:GameStatusManager+UI.AppTitle}"
        Height="650" Width="920" MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#0a0a0a">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderBrush" Value="#484848"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel Background="#0a0a0a">

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{x:Static svc:GameStatusManager+UI.MenuFile}" Foreground="#808080">
                <MenuItem Header="{x:Static svc:GameStatusManager+UI.MenuSelectEngine}"
                          Click="SelectEngine_Click" Foreground="Black"/>
                <Separator Background="#3c3c3c"/>
                <MenuItem Header="{x:Static svc:GameStatusManager+UI.MenuClose}"
                          Click="Exit_Click" Foreground="Black"/>
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="20">
                <Viewbox Stretch="Uniform">
                    <views:ChessBoardView x:Name="BoardView" Width="600" Height="600"/>
                </Viewbox>
            </Grid>

            <Border Grid.Column="1" HorizontalAlignment="Left" Width="1"
                    Background="#484848" Margin="0,8"/>

            <Grid Grid.Column="1" Margin="12,12,12,12">
                <views:GameControlsView x:Name="ControlsView"/>
            </Grid>


            <Border Grid.ColumnSpan="2"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,40"
                    Padding="16,8"
                    CornerRadius="4"
                    Background="#e06c75"
                    BorderBrush="#484848"
                    BorderThickness="1"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ToastMessage}"
                           Foreground="#0a0a0a"
                           FontSize="12"
                           FontWeight="SemiBold"
                           FontFamily="Cascadia Mono, Consolas, monospace"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
